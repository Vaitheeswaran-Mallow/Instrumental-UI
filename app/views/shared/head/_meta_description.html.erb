<% meta_description = if content_for?(:meta_description)
                        yield(:meta_description)
                      elsif @page_title.present?
                        @page_title
                      else
                        "A Ruby on Rails UI Component Library for modern products & sites, designed for speed and flexibility."
                      end
%>

<meta name="description"
      content="<%= meta_description.strip %>">
<meta property="og:description"
      content="<%= meta_description.strip %>">
