<%
  page_title = if content_for?(:page_title)
                  yield(:page_title)
                elsif @page_title.present?
                  @page_title
                else
                  "Instrumental.dev - Rails UI Components to Build Better Products, Faster"
                end
%>

<title>
  <%= page_title.strip %>
</title>

<meta property="og:title"
      content="<%= page_title.strip %>">
