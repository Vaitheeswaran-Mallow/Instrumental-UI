<%= render "shared/head/page_title" %>
<meta name="viewport" content="width=device-width,initial-scale=1">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%= render "shared/head/meta_description" %>
<%= render "shared/head/meta_og_images" %>

<link
  rel="preconnect"
  href="https://fonts.googleapis.com"
  />
<link
  rel="preconnect"
  href="https://fonts.gstatic.com"
  crossorigin
  />
<link
  href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap"
  rel="stylesheet"
  />

<script src="https://kit.fontawesome.com/8fdfd1ae57.js" crossorigin="anonymous"></script>

<%= favicon_link_tag url_for('favicon.ico') %>

<%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
