<%
  container_attrs = container_attributes(local_assigns)
  field_attrs = field_attributes(local_assigns)
  label_attrs = label_attributes(local_assigns, field_attrs)
  description_attrs = description_attributes(local_assigns)

  default_field_data = {
    "components--color-picker-target": "colorPicker"
  }
  field_data = if field_attrs[:data].present?
                 merge_data_attributes(default_field_data, field_attrs[:data])
               else
                 default_field_data
               end
%>

<%= render "shared/components/fields/field",
           container_attributes: container_attrs,
           field_attributes: field_attrs,
           label_attributes: label_attrs,
           description_attributes: description_attrs do %>
  <div class="form-control color-picker
              inline-flex items-center space-x-4"
       data-controller="components--color-picker">
    <input type="text"
           class="border-none outline-none bg-transparent p-0 flex-1
                  focus:outline-none border-transparent focus:border-transparent focus:ring-0"
           value="<%= field_attrs[:value] %>"
           data-action="focus->components--color-picker#focus blur->components--color-picker#blur input->components--color-picker#updateColorPicker"
    data-components--color-picker-target="hexInput">

    <%= form.color_field field_attrs[:field_name],
                          autofocus: field_attrs[:autofocus],
                          placeholder: field_attrs[:placeholder],
                          class: "w-8 h-8 border-none outline-none bg-transparent p-0",
                          value: field_attrs[:value],
                          data: field_data %>

  </div>
<% end %>
