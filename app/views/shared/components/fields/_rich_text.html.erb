<%
  compact_style = local_assigns.fetch(:compact_style, true)
  hide_toolbar = local_assigns.fetch(:hide_toolbar, false)
  base_container_classes = hide_toolbar ? "rich-text-container hide-rich-text-toolbar" : "rich-text-container"
  existing_container_classes = local_assigns[:container_classes] || ""
  additional_container_classes = compact_style ? "#{base_container_classes} form-control compact-rich-text" : base_container_classes
  local_assigns[:container_classes] = "#{existing_container_classes} #{additional_container_classes}".strip

  container_attrs = container_attributes(local_assigns)
  field_attrs = field_attributes(local_assigns)
  label_attrs = label_attributes(local_assigns, field_attrs)
  description_attrs = description_attributes(local_assigns)

  default_field_data = {
    controller: "components--rich-text",
    action: "#{compact_style ? "focus->components--rich-text#focus blur->components--rich-text#unfocus" : nil}"
  }
  field_data = if field_attrs[:data].present?
                 merge_data_attributes(default_field_data, field_attrs[:data])
               else
                 default_field_data
               end
%>

<%= render "shared/components/fields/field",
           container_attributes: container_attrs,
           field_attributes: field_attrs,
           label_attributes: label_attrs,
           description_attributes: description_attrs,
           compact_rich_text: compact_style do %>
  <%= form.rich_text_area field_attrs[:field_name],
                          class: compact_style ? nil : "form-control",
                          data: field_data %>
<% end %>
