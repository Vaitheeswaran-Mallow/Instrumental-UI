<%
  model = local_assigns[:model]
  errors = local_assigns[:errors] || model&.errors # use for sending model validations or an array of errors
  error_message = local_assigns[:error_message] # use for sending a single error message
  errors_present = errors.present? || error_message.present?
%>

<% if errors_present %>
  <turbo-frame id="error_explanation">
    <div class="bg-red-200 text-red-700 p-4 rounded-lg mb-8 font-medium">
      <% if errors.present? %>
        <h2 class="mb-4 pt-0 text-red-700 text-lg font-medium">
          <% if model.present? %>
            <%= pluralize(errors.count, "error") %> prohibited this <%= model.class.name.downcase %> from being saved:
          <% elsif errors.present? %>
            <%= pluralize(errors.count, "error") %> prohibited this form from being submitted:
          <% end %>
        </h2>
      <% end %>
      <% if error_message.present? %>
        <p><%= error_message %></p>
      <% end %>
      <% if errors.present? %>
        <ul class="list-disc ml-6">
          <% errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </turbo-frame>
<% end %>
