<%
  text = local_assigns[:text]
  bg_color = local_assigns[:bg_color] || "bg-gray-100 dark:bg-gray-950"
  padding = local_assigns[:padding] || "py-1.5 pr-2.5 pl-3"
  text_color = local_assigns[:text_color] || "text-gray-500 dark:text-gray-300"
  text_size = local_assigns[:text_size] || "text-base"
  label_classes = local_assigns[:label_classes]
  icon_name = local_assigns[:icon_name] # font-awesome icon name (not including the fa-)
  icon_classes = local_assigns[:icon_classes] || "fa-solid fa-sm" # font-awesome icon classes EXCEPT for the icon name class (that's defined in icon_name)
  icon_container_classes = local_assigns[:icon_container_classes]
%>

<div class="inline-flex items-center space-x-2 font-medium rounded
            <%= bg_color %>
            <%= text_color %>
            <%= padding %>
            <%= text_size %>
            <%= label_classes %>">
  <% if icon_name %>
    <div class="<%= icon_container_classes %>">
      <i class="<%= icon_classes %> fa-<%= icon_name %>"></i>
    </div>
  <% end %>
  <span>
    <%= text %>
  </span>
</div>
